# Copy to .env (or .env.local) and uncomment what you need. Both variables are optional:
# without them the SPA and the dev-server proxy use the deployed Azure App Service backend.

# Absolute base URL the SPA calls at runtime (no trailing slash).
# Default: https://weatherdemoapp-h0a4ggb7dzh4href.indiasouthcentral-01.azurewebsites.net
# Set it to an empty value to use same-origin requests (dev proxy / API wwwroot).
# VITE_API_BASE_URL=http://localhost:5080

# Target of the Vite dev-server proxy for /api and /health (npm run dev only).
# VITE_API_TARGET=http://localhost:5080
